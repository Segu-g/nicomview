{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@testing-library/jest-dom/vitest"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/plugins/**/*.ts", "src/plugins/**/*.tsx"]
}
